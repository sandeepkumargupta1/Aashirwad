# Optional: point the hosted/local TypeScript API adapter at your running FastAPI service.
# Leave blank to use built-in hosted NASA POWER + browser soil-test workflow.
PYTHON_API_BASE_URL=
# Set for the local Python process. Never commit imported private datasets or trained binaries.
AASHIRWAD_DATA_DIR=./data
AASHIRWAD_SOIL_DEPTH=0-30cm

# Optional compatible geocoder. Public Nominatim is for this low-traffic private demo only.
# Follow https://operations.osmfoundation.org/policies/nominatim/ and use shared rate limiting at scale.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
